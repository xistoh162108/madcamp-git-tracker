# raw per-commit ledgers -- only used to *derive* the snapshot JSON below during a sync; not
# needed by the frozen static pages (which only import the already-aggregated snapshots), and
# next camp season's dynamic mode regenerates these from scratch. Not source, still untracked.
/data/commits/
/data/sync-reports/

# public/data/snapshots/*.json used to be untracked runtime output (regenerated by cron / admin
# actions in production; a deploy must never overwrite it with a stale git-committed copy). Camp
# is over -- these are now the final, frozen record and are committed so the static pages can
# import them directly at build time (see src/snapshot/frozen.ts). Do NOT resume ignoring these
# unless dynamic (cron-driven) syncing resumes for a future camp.

# live roster -- was editable in production via the admin CSV upload while the camp was live; the
# tracked copy is now the final, frozen roster (see /public/data/snapshots/*.json note above).
# Do NOT resume ignoring this unless a future camp's dynamic admin-upload flow resumes.

# static export staging (see scripts/export-static-site.sh)
/.export-staging/

# standalone art demo (immersion marathon), never part of the tracked app
/marathon/
